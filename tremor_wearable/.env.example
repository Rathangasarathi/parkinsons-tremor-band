# Copy to .env (never commit .env). All values optional.
HOST=0.0.0.0
PORT=8000
# If set, the ESP32 must connect with the same token (secrets.h DEVICE_TOKEN)
DEVICE_TOKEN=
# 1 = start with the clearly-labelled simulator when no real device is connected
SIMULATE=0
DATA_DIR=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
